# Dynatrace OTEL Export Configuration
# Copy to .env.dynatrace and fill in your values.
#
# API Token scopes needed: metrics.ingest, traces.ingest, logs.ingest
DYNATRACE_ENDPOINT=https://{your-env-id}.live.dynatrace.com/api/v2/otlp
DYNATRACE_API_TOKEN=dt0c01.XXXXXXXX.YYYYYYYY

# Bizevents ingest — high-frequency acceleration data as business events
# API Token scope needed: bizevents.ingest
DYNATRACE_BIZEVENTS_ENDPOINT=https://{your-env-id}.live.dynatrace.com/api/v2/bizevents/ingest
DYNATRACE_BIZEVENTS_TOKEN=dt0c01.XXXXXXXX.YYYYYYYY

# For Monaco dashboard/alert deployment:
# OAuth client scopes: app-engine:apps:run, document:documents:write,
#   document:documents:read, settings:objects:write, settings:objects:read
DYNATRACE_ENVIRONMENT_URL=https://{your-env-id}.apps.dynatrace.com
DYNATRACE_OAUTH_CLIENT_ID=dt0s02.XXXXXXXX
DYNATRACE_OAUTH_CLIENT_SECRET=dt0s02.XXXXXXXX.YYYYYYYY
DYNATRACE_TOKEN_ENDPOINT=https://sso.dynatrace.com/sso/oauth2/token
