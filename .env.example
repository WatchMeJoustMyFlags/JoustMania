# Environment configuration for JoustMania
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

ENV=dev

# ---- Decision-backend API keys (#1244) ----
# Do NOT put API keys in .env: it is TRACKED in git despite .gitignore.
# Export them in your shell, or put them in the git-ignored .env.local and load
# both files (later wins; passing --env-file disables the implicit .env):
#   docker compose --env-file .env --env-file .env.local up -d
# The keys go straight to the agent (no gateway); an empty key keeps that
# backend unavailable, so decisions fall back to rules. ANTHROPIC_API_KEY also
# serves the post-game retro / experiment proposer when
# AGENT_INFERENCE_BACKEND=claude (#1234).
# ANTHROPIC_API_KEY=
# DECISION_OPENAI_API_KEY=
# JEV_API_KEY=
