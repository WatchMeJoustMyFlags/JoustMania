{
  "metadata": {
    "flagSetId": "observability"
  },
  "flags": {
    "metrics_export_interval_ms": {
      "state": "ENABLED",
      "variants": {
        "overkill": 10,
        "realtime": 100,
        "normal": 1000
      },
      "defaultVariant": "normal",
      "targeting": {
        "if": [
          {
            "==": [
              {
                "var": "service"
              },
              "controller-manager-service"
            ]
          },
          "realtime",
          null
        ]
      }
    },
    "grpc_rpc_spans": {
      "state": "ENABLED",
      "variants": {
        "enabled": true,
        "disabled": false
      },
      "defaultVariant": "enabled"
    },
    "otel_bsp_schedule_delay_millis": {
      "state": "ENABLED",
      "variants": {
        "fast": 500,
        "default": 5000
      },
      "defaultVariant": "default",
      "targeting": {
        "if": [
          {
            "==": [
              {
                "var": "service"
              },
              "controller-manager-service"
            ]
          },
          "fast",
          null
        ]
      }
    }
  }
}
