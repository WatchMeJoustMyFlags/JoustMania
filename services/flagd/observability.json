{
  "metadata": {
    "flagSetId": "observability"
  },
  "flags": {
    "metrics_export_interval_ms": {
      "state": "ENABLED",
      "variants": {
        "overkill": 10,
        "realtime": 100,
        "normal": 1000
      },
      "defaultVariant": "normal",
      "targeting": {
        "if": [
          {
            "in": [
              {
                "var": "service"
              },
              [
                "controller-manager-service",
                "game-coordinator-service"
              ]
            ]
          },
          "realtime",
          null
        ]
      }
    },
    "grpc_rpc_spans": {
      "state": "ENABLED",
      "variants": {
        "enabled": true,
        "disabled": false
      },
      "defaultVariant": "enabled"
    },
    "otel_bsp_schedule_delay_millis": {
      "state": "ENABLED",
      "variants": {
        "fast": 500,
        "default": 5000
      },
      "defaultVariant": "default",
      "targeting": {
        "if": [
          {
            "==": [
              {
                "var": "service"
              },
              "controller-manager-service"
            ]
          },
          "fast",
          null
        ]
      }
    },
    "flagservice.propagation_probe": {
      "state": "ENABLED",
      "variants": {
        "none": ""
      },
      "defaultVariant": "none"
    },
    "telemetry.experiment_game_parent": {
      "state": "ENABLED",
      "variants": {
        "child": "child",
        "link": "link"
      },
      "defaultVariant": "link"
    },
    "log_level": {
      "state": "ENABLED",
      "variants": {
        "debug": "debug",
        "info": "info",
        "warning": "warning",
        "error": "error"
      },
      "defaultVariant": "info"
    },
    "debug": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off"
    }
  }
}
