          "expr": "sum by (decide_backend, decide_outcome) (rate(traces_span_metrics_calls_total{span_name=\"agent.decide\"}[1m])) * 60 or on() label_replace(vector(0), \"decide_backend\", \"none\", \"\", \"\")",
