      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "game_active by kind: real = the menu game the audience sees, shadow = headless agent games.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "text": {
          "titleSize": 24,
          "valueSize": 80
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(game_active{game_kind=\"primary\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "real"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(game_active{game_kind=\"shadow\"}) or vector(0)",
          "refId": "B",
          "legendFormat": "shadow"
        }
      ],
      "title": "Live games",
      "type": "stat"
    },
