      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (rate(game_interventions_total{blocked=\"false\"}[1m])) * 60 or on() label_replace(vector(0), \"type\", \"none\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "{{type}}"
        }
      ],
      "title": "Interventions applied / min (by type)",
      "type": "timeseries"
    },
