          "legendFormat": "rust p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by(le) (rate(controller_input_lag_seconds_bucket[1m]) * on(serial) group_left(backend) controller_backend_info{backend=\"hidapi\"}))",
