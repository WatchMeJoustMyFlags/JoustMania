          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "collector 1": true,
              "collector 2": true,
              "collector 3": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "otel_scope_name 1": true,
              "otel_scope_name 2": true,
              "otel_scope_name 3": true,
              "otel_scope_version 1": true,
              "otel_scope_version 2": true,
              "otel_scope_version 3": true,
              "pipeline 1": true,
              "pipeline 2": true,
              "pipeline 3": true
            },
            "indexByName": {
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "job": 0
            },
            "renameByName": {
              "Value #A": "CPU %",
              "Value #B": "Memory",
              "Value #C": "Threads",
              "job": "Service"
            }
          }
        }
      ],
      "type": "table"
