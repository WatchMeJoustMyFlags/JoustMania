{
  "version": 14,
  "variables": [],
  "tiles": {
    "controller-honeycomb": {
      "type": "data",
      "title": "Controller Status",
      "description": "Each cell is a controller, colored by connection status",
      "query": "timeseries connected = avg(controller_connected), by:{serial} | fieldsAdd last = arrayLast(connected) | fields serial, last",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "honeycomb",
      "visualizationConfig": {
        "colorMode": "threshold",
        "shape": "hexagon",
        "label": "serial",
        "colorField": "last",
        "thresholds": [
          { "value": 0, "color": "red", "label": "Offline" },
          { "value": 0.5, "color": "green", "label": "Online" }
        ]
      }
    },
    "battery-honeycomb": {
      "type": "data",
      "title": "Battery Level",
      "description": "Each cell is a controller, colored by battery level",
      "query": "timeseries battery = avg(controller_battery_level), by:{serial} | fieldsAdd last = arrayLast(battery) | fields serial, last",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "honeycomb",
      "visualizationConfig": {
        "colorMode": "threshold",
        "shape": "hexagon",
        "label": "serial",
        "colorField": "last",
        "thresholds": [
          { "value": 0, "color": "red", "label": "Critical" },
          { "value": 2, "color": "yellow", "label": "Low" },
          { "value": 3, "color": "green", "label": "OK" }
        ]
      }
    },
    "signal-honeycomb": {
      "type": "data",
      "title": "Signal Strength",
      "description": "Each cell is a controller, colored by Bluetooth RSSI",
      "query": "timeseries rssi = avg(bluetooth_device_rssi_dbm), by:{serial} | fieldsAdd last = arrayLast(rssi) | fields serial, last",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "honeycomb",
      "visualizationConfig": {
        "colorMode": "threshold",
        "shape": "hexagon",
        "label": "serial",
        "colorField": "last",
        "thresholds": [
          { "value": -90, "color": "red", "label": "Weak" },
          { "value": -70, "color": "yellow", "label": "Fair" },
          { "value": -50, "color": "green", "label": "Strong" }
        ]
      }
    },
    "controller-detail-table": {
      "type": "data",
      "title": "Controller Details",
      "description": "All controllers with battery, signal, and connection",
      "query": "timeseries battery = avg(controller_battery_level), rssi = avg(bluetooth_device_rssi_dbm), connected = avg(controller_connected), by:{serial}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "table"
    },
    "button-events": {
      "type": "data",
      "title": "Button Events",
      "description": "Button event rate over time",
      "query": "timeseries sum(controller_button_events_total, rate: 1m)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "legend": { "position": "bottom" }
      }
    },
    "disconnects": {
      "type": "data",
      "title": "Disconnects",
      "description": "Controller disconnect rate over time",
      "query": "timeseries sum(controller_disconnect_total, rate: 1m)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "legend": { "position": "bottom" },
        "thresholds": [
          { "value": 1, "color": "yellow" },
          { "value": 3, "color": "red" }
        ]
      }
    },
    "poll-mode": {
      "type": "data",
      "title": "Poll Mode",
      "description": "Idle (10Hz) vs Gameplay (100Hz)",
      "query": "timeseries avg(controller_polling_mode)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "blue" },
          { "value": 1, "color": "green" }
        ],
        "valueMappings": [
          { "value": 0, "displayValue": "Idle" },
          { "value": 1, "displayValue": "Gameplay" }
        ],
        "colorMode": "background"
      }
    },
    "active-streams": {
      "type": "data",
      "title": "Active Streams",
      "description": "Active data streams",
      "query": "timeseries avg(controller_streams_active)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    }
  },
  "layouts": {
    "0": { "x": 0, "y": 0, "w": 8, "h": 8, "key": "controller-honeycomb" },
    "1": { "x": 8, "y": 0, "w": 8, "h": 8, "key": "battery-honeycomb" },
    "2": { "x": 16, "y": 0, "w": 8, "h": 8, "key": "signal-honeycomb" },
    "3": { "x": 0, "y": 8, "w": 16, "h": 6, "key": "controller-detail-table" },
    "4": { "x": 16, "y": 8, "w": 4, "h": 3, "key": "poll-mode" },
    "5": { "x": 20, "y": 8, "w": 4, "h": 3, "key": "active-streams" },
    "6": { "x": 0, "y": 14, "w": 12, "h": 6, "key": "button-events" },
    "7": { "x": 12, "y": 14, "w": 12, "h": 6, "key": "disconnects" }
  }
}
