{
  "version": 14,
  "variables": [],
  "tiles": {
    "controller-health": {
      "type": "data",
      "title": "Controller Health",
      "description": "Each cell is a controller. Color = connection status. Overlay shows battery level and signal strength.",
      "query": "timeseries connected = avg(controller_connected), battery = avg(controller_battery_level), rssi = avg(bluetooth_device_rssi_dbm), by:{serial} | fieldsAdd status = arrayLast(connected), batteryLevel = arrayLast(battery), signalDbm = arrayLast(rssi) | fields serial, status, batteryLevel, signalDbm",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "honeycomb",
      "visualizationConfig": {
        "colorMode": "threshold",
        "shape": "hexagon",
        "label": "serial",
        "colorField": "status",
        "thresholds": [
          { "value": 0, "color": "red", "label": "Offline" },
          { "value": 0.5, "color": "green", "label": "Online" }
        ]
      }
    },
    "adapter-load": {
      "type": "data",
      "title": "Adapter Load",
      "description": "Each cell is a Bluetooth adapter. Color = connection count. Hover for details.",
      "query": "timeseries connections = avg(bluetooth_adapter_connections), by:{hci_adapter} | fieldsAdd load = arrayLast(connections) | fields hci_adapter, load",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "honeycomb",
      "visualizationConfig": {
        "colorMode": "threshold",
        "shape": "hexagon",
        "label": "hci_adapter",
        "colorField": "load",
        "thresholds": [
          { "value": 0, "color": "gray", "label": "Idle" },
          { "value": 1, "color": "green", "label": "Normal" },
          { "value": 4, "color": "yellow", "label": "High" },
          { "value": 6, "color": "red", "label": "Overloaded" }
        ]
      }
    },
    "poll-mode": {
      "type": "data",
      "title": "Poll Mode",
      "description": "Idle (10Hz) vs Gameplay (100Hz)",
      "query": "timeseries avg(controller_polling_mode)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "blue" },
          { "value": 1, "color": "green" }
        ],
        "valueMappings": [
          { "value": 0, "displayValue": "Idle" },
          { "value": 1, "displayValue": "Gameplay" }
        ],
        "colorMode": "background"
      }
    },
    "active-streams": {
      "type": "data",
      "title": "Active Streams",
      "description": "Active data streams",
      "query": "timeseries avg(controller_streams_active)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "controller-detail-table": {
      "type": "data",
      "title": "Controller Details",
      "description": "All controllers with battery, signal, connection status, and adapter",
      "query": "timeseries battery = avg(controller_battery_level), rssi = avg(bluetooth_device_rssi_dbm), connected = avg(controller_connected), by:{serial}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "table"
    },
    "adapter-signal": {
      "type": "data",
      "title": "Signal Strength by Adapter",
      "description": "Average RSSI per Bluetooth adapter over time",
      "query": "timeseries avg(bluetooth_device_rssi_dbm), by:{hci_adapter}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxis": { "min": -90, "max": -30, "label": "dBm" },
        "legend": { "position": "bottom" },
        "thresholds": [
          { "value": -70, "color": "yellow" },
          { "value": -85, "color": "red" }
        ]
      }
    },
    "button-events": {
      "type": "data",
      "title": "Button Events",
      "description": "Button event rate over time",
      "query": "timeseries sum(controller_button_events_total, rate: 1m)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "legend": { "position": "bottom" }
      }
    },
    "disconnects": {
      "type": "data",
      "title": "Disconnects",
      "description": "Controller disconnect rate over time",
      "query": "timeseries sum(controller_disconnect_total, rate: 1m)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "legend": { "position": "bottom" },
        "thresholds": [
          { "value": 1, "color": "yellow" },
          { "value": 3, "color": "red" }
        ]
      }
    }
  },
  "layouts": {
    "0": { "x": 0,  "y": 0,  "w": 14, "h": 10, "key": "controller-health" },
    "1": { "x": 14, "y": 0,  "w": 6,  "h": 10, "key": "adapter-load" },
    "2": { "x": 20, "y": 0,  "w": 4,  "h": 5,  "key": "poll-mode" },
    "3": { "x": 20, "y": 5,  "w": 4,  "h": 5,  "key": "active-streams" },
    "4": { "x": 0,  "y": 10, "w": 14, "h": 6,  "key": "controller-detail-table" },
    "5": { "x": 14, "y": 10, "w": 10, "h": 6,  "key": "adapter-signal" },
    "6": { "x": 0,  "y": 16, "w": 12, "h": 6,  "key": "button-events" },
    "7": { "x": 12, "y": 16, "w": 12, "h": 6,  "key": "disconnects" }
  }
}
