{
  "version": 14,
  "variables": [],
  "tiles": {
    "connected-controllers": {
      "type": "data",
      "title": "Connected Controllers",
      "description": "Number of currently connected controllers",
      "query": "timeseries avg(controller_connected), by:{serial} | filter value[] == 1 | summarize count()",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "low-battery": {
      "type": "data",
      "title": "Low Battery",
      "description": "Controllers with low battery (level <= 2)",
      "query": "timeseries avg(controller_battery_level), by:{serial} | filter value[] <= 2 | summarize count() | fieldsAdd default(value, default:0)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 1, "color": "yellow" },
          { "value": 2, "color": "red" }
        ]
      }
    },
    "weak-signal": {
      "type": "data",
      "title": "Weak Signal",
      "description": "Controllers with weak signal (RSSI < -70 dBm)",
      "query": "timeseries avg(bluetooth_device_rssi_dbm), by:{serial} | filter value[] < -70 | summarize count() | fieldsAdd default(value, default:0)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 1, "color": "yellow" },
          { "value": 2, "color": "red" }
        ]
      }
    },
    "controller-status-table": {
      "type": "data",
      "title": "Controller Status Table",
      "description": "All connected controllers with battery, signal, and status",
      "query": "timeseries battery = avg(controller_battery_level), rssi = avg(bluetooth_device_rssi_dbm), connected = avg(controller_connected), by:{serial}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "table",
      "visualizationConfig": {
        "columns": ["serial", "battery", "rssi", "connected"],
        "columnAliases": {
          "serial": "Serial",
          "battery": "Battery",
          "rssi": "Signal (dBm)",
          "connected": "Status"
        }
      }
    },
    "button-events-1m": {
      "type": "data",
      "title": "Button Events (1m)",
      "description": "Total button events in last minute",
      "query": "timeseries sum(delta(controller_button_events_total))",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "blue" }
        ]
      }
    },
    "disconnects-5m": {
      "type": "data",
      "title": "Disconnects (5m)",
      "description": "Total disconnects in last 5 minutes",
      "query": "timeseries sum(delta(controller_disconnect_total))",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 1, "color": "yellow" },
          { "value": 3, "color": "red" }
        ]
      }
    },
    "active-streams": {
      "type": "data",
      "title": "Active Streams",
      "description": "Active data streams",
      "query": "timeseries avg(controller_streams_active)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "poll-mode": {
      "type": "data",
      "title": "Poll Mode",
      "description": "Current polling mode: Idle (10Hz) or Gameplay (100Hz)",
      "query": "timeseries avg(controller_polling_mode)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "blue" },
          { "value": 1, "color": "green" }
        ],
        "valueMappings": [
          { "value": 0, "displayValue": "Idle" },
          { "value": 1, "displayValue": "Gameplay" }
        ],
        "colorMode": "background"
      }
    },
    "poll-rate": {
      "type": "data",
      "title": "Poll Rate",
      "description": "Current controller polling rate in Hz",
      "query": "timeseries avg(controller_polling_target_hz)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "unit": "hertz",
        "thresholds": [
          { "value": 0, "color": "blue" },
          { "value": 60, "color": "green" }
        ]
      }
    }
  },
  "layouts": {
    "0": { "x": 0, "y": 0, "w": 4, "h": 4, "key": "connected-controllers" },
    "1": { "x": 4, "y": 0, "w": 4, "h": 4, "key": "low-battery" },
    "2": { "x": 8, "y": 0, "w": 4, "h": 4, "key": "weak-signal" },
    "3": { "x": 12, "y": 0, "w": 12, "h": 8, "key": "controller-status-table" },
    "4": { "x": 0, "y": 4, "w": 4, "h": 4, "key": "button-events-1m" },
    "5": { "x": 4, "y": 4, "w": 4, "h": 4, "key": "disconnects-5m" },
    "6": { "x": 8, "y": 4, "w": 4, "h": 4, "key": "active-streams" },
    "7": { "x": 12, "y": 8, "w": 6, "h": 4, "key": "poll-mode" },
    "8": { "x": 18, "y": 8, "w": 6, "h": 4, "key": "poll-rate" }
  }
}
