    "11": {
      "content": "## Player Activity & Events\n\nPer-player honeycomb activity map, peak acceleration tracking, and event rates.\n\n-----",
      "type": "markdown"
    },
    "12": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Player Activity",
      "type": "data",
      "query": "timeseries accel = avg(game_player_accel_magnitude), peak = avg(game_player_peak_accel), by:{serial} | fieldsAdd accelLast = arrayLast(accel), peakLast = arrayLast(peak) | fields serial, accelLast, peakLast",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "honeycomb",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "honeycomb": {
          "colorMode": "custom-colors",
          "colorPalette": "blue",
          "dataMappings": {
            "value": "accelLast"
          },
          "displayedFields": [
            "serial",
            "accelLast",
            "peakLast"
          ],
          "customColors": [
            {
              "comparator": "≥",
              "value": 0,
              "color": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            },
            {
              "comparator": "≥",
              "value": 1.0,
              "color": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "comparator": "≥",
              "value": 1.5,
              "color": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "≥",
              "field": "accelLast",
              "value": 0,
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "≥",
              "field": "accelLast",
              "value": 1.0,
              "customColor": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "≥",
              "field": "accelLast",
              "value": 1.5,
              "customColor": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        }
      }
    },
