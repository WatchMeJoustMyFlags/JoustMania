    "10": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Data Points per Player (last 1m)",
      "type": "data",
      "query": "fetch bizevents\n| filter event.type == \"com.joustmania.acceleration\"\n| filter metric.name == \"controller_accel_magnitude\"\n| summarize points = count(), avgAccel = avg(metric.value), maxAccel = max(metric.value), by:{serial}\n| sort points desc",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "table",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "table": {
          "enableSparklines": false,
          "hiddenColumns": [],
          "lineWrapIds": [],
          "columnWidths": {},
          "columns": [
            {
              "columnId": "serial",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "points",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "avgAccel",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "maxAccel",
              "columnType": "data",
              "visible": true
            }
          ]
        }
      }
