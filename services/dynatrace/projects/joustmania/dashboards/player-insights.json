{
  "version": 14,
  "variables": [],
  "tiles": {
    "0": {
      "content": "## Player Insights\n\nPer-player gameplay view with **100Hz acceleration** via bizevents — full-resolution data that metrics (1-min aggregation) cannot capture.\n\n-----",
      "type": "markdown"
    },
    "1": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Players Alive",
      "type": "data",
      "query": "timeseries alive = avg(game_players_alive), total = avg(game_active_players)",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "lineChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": [
              "alive",
              "total"
            ],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "Players"
          },
          "legend": {
            "hidden": false
          },
          "truncationMode": "end",
          "colorPalette": "categorical"
        },
        "thresholds": []
      }
    },
    "2": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Death Threshold",
      "type": "data",
      "query": "timeseries t = avg(game_effective_death_threshold) | fieldsAdd last = arrayLast(t) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "≥",
              "field": "last",
              "value": 2.2,
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "<",
              "field": "last",
              "value": 2.2,
              "customColor": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "<",
              "field": "last",
              "value": 1.8,
              "customColor": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        }
      }
    },
    "3": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Music Tempo",
      "type": "data",
      "query": "timeseries tempo = avg(game_music_tempo) | fieldsAdd last = arrayLast(tempo) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
    "4": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Near-Deaths",
      "type": "data",
      "query": "timeseries nd = sum(game_near_death_events_total) | fieldsAdd last = arrayLast(nd) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
    "5": {
      "content": "## 100Hz Acceleration (Bizevents)\n\nRaw acceleration data at full sensor resolution. Each point is a real controller reading — no aggregation.\n\n-----",
      "type": "markdown"
    },
    "6": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Acceleration Magnitude per Player (100Hz)",
      "type": "data",
      "query": "fetch bizevents\n| filter event.type == \"com.joustmania.acceleration\"\n| filter metric.name == \"controller_accel_magnitude\"\n| fields timestamp, serial, accel = metric.value\n| sort timestamp asc",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 50000
      },
      "visualization": "lineChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": [
              "accel"
            ],
            "seriesField": "serial",
            "timestamp": "timestamp"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "Acceleration (g)"
          },
          "gapPolicy": "connect",
          "legend": {
            "hidden": false
          },
          "truncationMode": "end"
        },
        "thresholds": [
          {
            "field": "accel",
            "isVisible": true,
            "value": 2.5,
            "label": "Death",
            "queryModifier": ""
          },
          {
            "field": "accel",
            "isVisible": true,
            "value": 1.6,
            "label": "Warning",
            "queryModifier": ""
          }
        ]
      }
    },
