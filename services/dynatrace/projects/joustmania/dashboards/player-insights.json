    "17": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Acceleration Distribution by Player",
      "type": "data",
      "query": "fetch bizevents\n| filter event.type == \"com.joustmania.acceleration\"\n| filter metric.name == \"controller_accel_magnitude\"\n| summarize p50 = percentile(metric.value, 50), p90 = percentile(metric.value, 90), p99 = percentile(metric.value, 99), max = max(metric.value), by:{serial}\n| sort max desc",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "table",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "table": {
          "enableSparklines": false,
          "hiddenColumns": [],
          "lineWrapIds": [],
          "columnWidths": {},
          "columns": [
            {
              "columnId": "serial",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "p50",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "p90",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "p99",
              "columnType": "data",
              "visible": true
            },
            {
              "columnId": "max",
              "columnType": "data",
              "visible": true
            }
          ]
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "≥",
              "field": "max",
              "value": 2.5,
              "customColor": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        }
