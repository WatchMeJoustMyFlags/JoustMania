{
  "version": 14,
  "variables": [],
  "tiles": {
    "game-intensity": {
      "type": "data",
      "title": "Game Intensity",
      "description": "Overall game activity level based on average player acceleration",
      "query": "timeseries avg(game_player_accel_magnitude)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "gauge",
      "visualizationConfig": {
        "min": 0,
        "max": 3,
        "unit": "g",
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 1.0, "color": "yellow" },
          { "value": 1.5, "color": "red" }
        ]
      }
    },
    "peak-acceleration": {
      "type": "data",
      "title": "Peak Acceleration (Running Max)",
      "description": "Peak acceleration per controller over time",
      "query": "timeseries avg(game_player_peak_accel), by:{serial}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisUnit": "g",
        "legend": { "position": "right" }
      }
    },
    "near-death-events": {
      "type": "data",
      "title": "Near-Death Events (per minute)",
      "description": "Rate of near-death events per player",
      "query": "timeseries sum(delta(game_near_death_events_total)) / duration(\"1m\") * 60, by:{serial, game_mode}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "drawStyle": "bar",
        "stacked": true,
        "legend": { "position": "right" }
      }
    },
    "warning-events": {
      "type": "data",
      "title": "Warning Events (per minute)",
      "description": "Rate of warning events per player",
      "query": "timeseries sum(delta(game_player_warnings_total)) / duration(\"1m\") * 60, by:{serial, game_mode}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "drawStyle": "bar",
        "stacked": true,
        "legend": { "position": "right" }
      }
    },
    "movement-zone-distribution": {
      "type": "data",
      "title": "Movement Zone Distribution",
      "description": "Distribution of player movement across acceleration zones",
      "query": "timeseries still = sum(delta(game_accel_distribution_bucket), filter:{le eq \"1.1\"}), active = sum(delta(game_accel_distribution_bucket), filter:{le eq \"1.5\"}) - sum(delta(game_accel_distribution_bucket), filter:{le eq \"1.1\"}), warning = sum(delta(game_accel_distribution_bucket), filter:{le eq \"2.0\"}) - sum(delta(game_accel_distribution_bucket), filter:{le eq \"1.5\"}), danger = sum(delta(game_accel_distribution_bucket), filter:{le eq \"+Inf\"}) - sum(delta(game_accel_distribution_bucket), filter:{le eq \"2.0\"})",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "pie",
      "visualizationConfig": {
        "pieType": "donut",
        "legend": { "position": "right" }
      }
    },
    "total-analytics-samples": {
      "type": "data",
      "title": "Total Analytics Samples",
      "description": "Total number of analytics samples collected",
      "query": "timeseries sum(game_analytics_samples_total)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "total-near-death-events": {
      "type": "data",
      "title": "Total Near-Death Events",
      "description": "Cumulative near-death events",
      "query": "timeseries sum(game_near_death_events_total)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 10, "color": "yellow" },
          { "value": 50, "color": "red" }
        ]
      }
    },
    "total-warning-events": {
      "type": "data",
      "title": "Total Warning Events",
      "description": "Cumulative warning events",
      "query": "timeseries sum(game_player_warnings_total)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "music-tempo": {
      "type": "data",
      "title": "Music Tempo",
      "description": "Current music tempo (1.0=Slow, 1.3=Fast)",
      "query": "timeseries avg(game_music_tempo)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "gray" },
          { "value": 0.5, "color": "green" },
          { "value": 1.15, "color": "orange" }
        ],
        "valueMappings": [
          { "value": 0, "displayValue": "No Game" },
          { "value": 1, "displayValue": "Slow" },
          { "value": 1.3, "displayValue": "Fast" }
        ],
        "colorMode": "background"
      }
    },
    "sensitivity": {
      "type": "data",
      "title": "Sensitivity",
      "description": "Current game sensitivity level (0=most sensitive, 4=least sensitive)",
      "query": "timeseries avg(game_sensitivity)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "valueMappings": [
          { "value": 0, "displayValue": "Ultra Slow" },
          { "value": 1, "displayValue": "Slow" },
          { "value": 2, "displayValue": "Medium" },
          { "value": 3, "displayValue": "Fast" },
          { "value": 4, "displayValue": "Ultra Fast" }
        ],
        "colorMode": "background"
      }
    },
    "effective-thresholds": {
      "type": "data",
      "title": "Effective Thresholds (Sensitivity + Music Speed)",
      "description": "Current effective warning and death thresholds",
      "query": "timeseries warning = avg(game_effective_warning_threshold), death = avg(game_effective_death_threshold)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisUnit": "g",
        "yAxisMin": 1.0,
        "yAxisMax": 4.0,
        "legend": { "position": "right" },
        "seriesOverrides": [
          { "name": "warning", "color": "yellow" },
          { "name": "death", "color": "red" }
        ]
      }
    },
    "music-tempo-over-time": {
      "type": "data",
      "title": "Music Tempo Over Time",
      "description": "Music tempo changes during gameplay",
      "query": "timeseries avg(game_music_tempo)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisMin": 0.9,
        "yAxisMax": 1.4,
        "legend": { "position": "bottom" }
      }
    }
  },
  "layouts": {
    "0": { "x": 0, "y": 0, "w": 6, "h": 8, "key": "game-intensity" },
    "1": { "x": 6, "y": 0, "w": 9, "h": 8, "key": "peak-acceleration" },
    "2": { "x": 15, "y": 0, "w": 9, "h": 8, "key": "near-death-events" },
    "3": { "x": 0, "y": 8, "w": 12, "h": 6, "key": "warning-events" },
    "4": { "x": 12, "y": 8, "w": 12, "h": 6, "key": "movement-zone-distribution" },
    "5": { "x": 0, "y": 14, "w": 6, "h": 4, "key": "total-analytics-samples" },
    "6": { "x": 6, "y": 14, "w": 6, "h": 4, "key": "total-near-death-events" },
    "7": { "x": 12, "y": 14, "w": 6, "h": 4, "key": "total-warning-events" },
    "8": { "x": 18, "y": 14, "w": 6, "h": 4, "key": "music-tempo" },
    "9": { "x": 0, "y": 18, "w": 4, "h": 4, "key": "sensitivity" },
    "10": { "x": 4, "y": 18, "w": 20, "h": 5, "key": "effective-thresholds" },
    "11": { "x": 0, "y": 23, "w": 24, "h": 5, "key": "music-tempo-over-time" }
  }
}
