{
  "version": 14,
  "variables": [],
  "tiles": {
    "0": {
      "content": "### Player Analytics\n\nMovement intensity per player. Hover a hexagon for peak acceleration and playstyle details.\n\n-----",
      "type": "markdown"
    },
    "1": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Player Activity",
      "type": "data",
      "query": "timeseries accel = avg(game_player_accel_magnitude), peak = avg(game_player_peak_accel), by:{serial} | fieldsAdd accelLast = arrayLast(accel), peakLast = arrayLast(peak) | fields serial, accelLast, peakLast",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "honeycomb",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "honeycomb": {
          "colorMode": "custom-colors",
          "colorPalette": "blue",
          "dataMappings": {
            "value": "accelLast"
          },
          "displayedFields": [
            "serial",
            "accelLast",
            "peakLast"
          ],
          "customColors": [
            {
              "comparator": "\u2265",
              "value": 0,
              "color": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            },
            {
              "comparator": "\u2265",
              "value": 1.0,
              "color": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "comparator": "\u2265",
              "value": 1.5,
              "color": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "accelLast",
              "value": 0,
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "accelLast",
              "value": 1.0,
              "customColor": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "accelLast",
              "value": 1.5,
              "customColor": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        }
      }
    },
    "2": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Music Tempo",
      "type": "data",
      "query": "timeseries tempo = avg(game_music_tempo) | fieldsAdd last = arrayLast(tempo) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
    "3": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Sensitivity",
      "type": "data",
      "query": "timeseries sens = avg(game_sensitivity) | fieldsAdd last = arrayLast(sens) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
    "4": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Near-Deaths",
      "type": "data",
      "query": "timeseries nd = sum(game_near_death_events_total) | fieldsAdd last = arrayLast(nd) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
