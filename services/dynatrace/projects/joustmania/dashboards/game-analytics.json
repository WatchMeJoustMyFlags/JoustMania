    "6": {
      "content": "### Movement & Thresholds\n\nPeak acceleration per controller and effective death/warning thresholds.\n\n-----",
      "type": "markdown"
    },
    "7": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Peak Acceleration by Controller",
      "type": "data",
      "query": "timeseries peak = avg(game_player_peak_accel), by:{serial}",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "lineChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": [
              "peak"
            ],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "Acceleration (g)"
          },
          "gapPolicy": "connect",
          "legend": {
            "hidden": false
          },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "8": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Effective Thresholds",
      "type": "data",
      "query": "timeseries warning = avg(game_effective_warning_threshold), death = avg(game_effective_death_threshold)",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "lineChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": [
              "warning",
              "death"
            ],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "Threshold (g)"
          },
          "gapPolicy": "connect",
          "legend": {
            "hidden": false
          },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "9": {
      "content": "### Events & Tempo\n\nNear-death and warning event rates over time, alongside music tempo changes.\n\n-----",
      "type": "markdown"
