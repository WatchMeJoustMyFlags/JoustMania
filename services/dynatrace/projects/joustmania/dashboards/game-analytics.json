{
  "version": 14,
  "variables": [],
  "tiles": {
    "player-activity": {
      "type": "data",
      "title": "Player Activity",
      "description": "Each cell is a player. Color = movement intensity (avg acceleration). Overlay shows peak accel, near-deaths, warnings.",
      "query": "timeseries accel = avg(game_player_accel_magnitude), peak = avg(game_player_peak_accel), by:{serial} | fieldsAdd accelLast = arrayLast(accel), peakLast = arrayLast(peak) | fields serial, accelLast, peakLast",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "honeycomb",
      "visualizationConfig": {
        "colorMode": "threshold",
        "shape": "hexagon",
        "label": "serial",
        "colorField": "accelLast",
        "thresholds": [
          { "value": 0, "color": "green", "label": "Calm" },
          { "value": 1.0, "color": "yellow", "label": "Active" },
          { "value": 1.5, "color": "red", "label": "Intense" }
        ]
      }
    },
    "game-intensity": {
      "type": "data",
      "title": "Game Intensity",
      "description": "Average player acceleration",
      "query": "timeseries avg(game_player_accel_magnitude)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "gauge",
      "visualizationConfig": {
        "min": 0,
        "max": 3,
        "unit": "g",
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 1.0, "color": "yellow" },
          { "value": 1.5, "color": "red" }
        ]
      }
    },
    "music-tempo": {
      "type": "data",
      "title": "Music Tempo",
      "description": "Current music speed",
      "query": "timeseries avg(game_music_tempo)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "gray" },
          { "value": 0.5, "color": "green" },
          { "value": 1.15, "color": "orange" }
        ],
        "valueMappings": [
          { "value": 0, "displayValue": "No Game" },
          { "value": 1, "displayValue": "Slow" },
          { "value": 1.3, "displayValue": "Fast" }
        ],
        "colorMode": "background"
      }
    },
    "sensitivity": {
      "type": "data",
      "title": "Sensitivity",
      "description": "Current game sensitivity (0=most, 4=least)",
      "query": "timeseries avg(game_sensitivity)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "valueMappings": [
          { "value": 0, "displayValue": "Ultra Slow" },
          { "value": 1, "displayValue": "Slow" },
          { "value": 2, "displayValue": "Medium" },
          { "value": 3, "displayValue": "Fast" },
          { "value": 4, "displayValue": "Ultra Fast" }
        ],
        "colorMode": "background"
      }
    },
    "total-near-deaths": {
      "type": "data",
      "title": "Near-Deaths",
      "description": "Cumulative near-death events",
      "query": "timeseries sum(game_near_death_events_total)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 10, "color": "yellow" },
          { "value": 50, "color": "red" }
        ]
      }
    },
    "total-warnings": {
      "type": "data",
      "title": "Warnings",
      "description": "Cumulative warning events",
      "query": "timeseries sum(game_player_warnings_total)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "peak-acceleration": {
      "type": "data",
      "title": "Peak Acceleration by Controller",
      "description": "Peak acceleration per controller over time",
      "query": "timeseries avg(game_player_peak_accel), by:{serial}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisUnit": "g",
        "legend": { "position": "right" }
      }
    },
    "effective-thresholds": {
      "type": "data",
      "title": "Effective Thresholds",
      "description": "Warning and death thresholds (sensitivity + music speed)",
      "query": "timeseries warning = avg(game_effective_warning_threshold), death = avg(game_effective_death_threshold)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisUnit": "g",
        "yAxisMin": 1.0,
        "yAxisMax": 4.0,
        "legend": { "position": "right" }
      }
    },
    "near-death-rate": {
      "type": "data",
      "title": "Near-Death Events Over Time",
      "description": "Near-death event rate by player and mode",
      "query": "timeseries sum(game_near_death_events_total, rate: 1m), by:{serial, game_mode}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "drawStyle": "bar",
        "stacked": true,
        "legend": { "position": "right" }
      }
    },
    "warning-rate": {
      "type": "data",
      "title": "Warning Events Over Time",
      "description": "Warning event rate by player and mode",
      "query": "timeseries sum(game_player_warnings_total, rate: 1m), by:{serial, game_mode}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "drawStyle": "bar",
        "stacked": true,
        "legend": { "position": "right" }
      }
    },
    "music-tempo-graph": {
      "type": "data",
      "title": "Music Tempo Over Time",
      "description": "Music tempo changes during gameplay",
      "query": "timeseries avg(game_music_tempo)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisMin": 0.9,
        "yAxisMax": 1.4,
        "legend": { "position": "bottom" }
      }
    }
  },
  "layouts": {
    "0":  { "x": 0,  "y": 0,  "w": 10, "h": 8,  "key": "player-activity" },
    "1":  { "x": 10, "y": 0,  "w": 6,  "h": 8,  "key": "game-intensity" },
    "2":  { "x": 16, "y": 0,  "w": 4,  "h": 4,  "key": "music-tempo" },
    "3":  { "x": 20, "y": 0,  "w": 4,  "h": 4,  "key": "sensitivity" },
    "4":  { "x": 16, "y": 4,  "w": 4,  "h": 4,  "key": "total-near-deaths" },
    "5":  { "x": 20, "y": 4,  "w": 4,  "h": 4,  "key": "total-warnings" },
    "6":  { "x": 0,  "y": 8,  "w": 12, "h": 7,  "key": "peak-acceleration" },
    "7":  { "x": 12, "y": 8,  "w": 12, "h": 7,  "key": "effective-thresholds" },
    "8":  { "x": 0,  "y": 15, "w": 8,  "h": 7,  "key": "near-death-rate" },
    "9":  { "x": 8,  "y": 15, "w": 8,  "h": 7,  "key": "warning-rate" },
    "10": { "x": 16, "y": 15, "w": 8,  "h": 7,  "key": "music-tempo-graph" }
  }
}
