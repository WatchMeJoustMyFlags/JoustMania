{
  "version": 14,
  "variables": [],
  "tiles": {
    "0": {
      "content": "### Game Status\n\nCurrent game state and player counts at a glance.\n\n-----",
      "type": "markdown"
    },
    "1": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Game Status",
      "type": "data",
      "query": "timeseries active = avg(game_active) | fieldsAdd last = arrayLast(active) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
    "2": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Active Players",
      "type": "data",
      "query": "timeseries players = avg(game_active_players) | fieldsAdd last = arrayLast(players) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
