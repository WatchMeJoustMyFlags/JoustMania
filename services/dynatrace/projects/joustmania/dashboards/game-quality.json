{
  "version": 14,
  "variables": [],
  "tiles": {
    "game-status": {
      "type": "data",
      "title": "Game Status",
      "description": "Current game state",
      "query": "timeseries avg(game_active)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "gray" },
          { "value": 1, "color": "green" }
        ],
        "valueMappings": [
          { "value": 0, "displayValue": "No Game" },
          { "value": 1, "displayValue": "Active" }
        ],
        "colorMode": "background"
      }
    },
    "active-players": {
      "type": "data",
      "title": "Active Players",
      "description": "Players in current game",
      "query": "timeseries avg(game_active_players)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "players-alive": {
      "type": "data",
      "title": "Players Alive",
      "description": "Players still in the game",
      "query": "timeseries avg(game_players_alive)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "game-duration": {
      "type": "data",
      "title": "Game Duration",
      "description": "Current game duration",
      "query": "timeseries avg(game_duration_seconds)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "unit": "seconds",
        "thresholds": [
          { "value": 0, "color": "green" }
        ]
      }
    },
    "frame-consistency": {
      "type": "data",
      "title": "Frame Consistency",
      "description": "% of frames within target timing",
      "query": "timeseries avg(game_loop_frame_consistency_percent)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "unit": "percent",
        "thresholds": [
          { "value": 0, "color": "red" },
          { "value": 90, "color": "yellow" },
          { "value": 95, "color": "green" }
        ],
        "colorMode": "background"
      }
    },
    "frame-jitter": {
      "type": "data",
      "title": "Frame Jitter",
      "description": "Stddev of frame times (lower = better)",
      "query": "timeseries avg(game_loop_jitter_ms)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "unit": "milliseconds",
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 5, "color": "yellow" },
          { "value": 10, "color": "red" }
        ],
        "colorMode": "background"
      }
    },
    "game-loop-hz": {
      "type": "data",
      "title": "Game Loop Rate",
      "description": "Actual game loop frequency over time",
      "query": "timeseries avg(game_actual_update_frequency_hz)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisUnit": "hertz",
        "yAxisMin": 0,
        "yAxisMax": 60,
        "legend": { "position": "bottom" },
        "thresholds": [
          { "value": 50, "color": "red" }
        ]
      }
    },
    "game-loop-jitter-graph": {
      "type": "data",
      "title": "Game Loop Jitter Over Time",
      "description": "Frame jitter trend (lower = smoother)",
      "query": "timeseries avg(game_loop_jitter_ms)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "yAxisUnit": "seconds",
        "yAxisMin": 0,
        "yAxisMax": 0.016,
        "legend": { "position": "bottom" },
        "thresholds": [
          { "value": 0.016, "color": "red" }
        ]
      }
    },
    "games-by-mode": {
      "type": "data",
      "title": "Games by Mode",
      "description": "Distribution of games started by mode",
      "query": "timeseries sum(games_started_total, rate: 1m), by:{mode}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "pie",
      "visualizationConfig": {
        "legend": { "position": "right" }
      }
    },
    "games-started": {
      "type": "data",
      "title": "Games Started Over Time",
      "description": "Game starts by mode",
      "query": "timeseries sum(games_started_total, rate: 1m), by:{mode}",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "graph",
      "visualizationConfig": {
        "drawStyle": "bar",
        "stacked": true,
        "legend": { "position": "bottom" }
      }
    },
    "dropped-frames": {
      "type": "data",
      "title": "Dropped Frames",
      "description": "Frames exceeding 2x target time",
      "query": "timeseries sum(game_loop_frames_dropped_total, rate: 1m)",
      "queryConfig": {
        "additionalFilters": [],
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "visualization": "singleValue",
      "visualizationConfig": {
        "thresholds": [
          { "value": 0, "color": "green" },
          { "value": 10, "color": "yellow" },
          { "value": 50, "color": "red" }
        ],
        "colorMode": "background"
      }
    }
  },
  "layouts": {
    "0":  { "x": 0,  "y": 0,  "w": 4, "h": 4, "key": "game-status" },
    "1":  { "x": 4,  "y": 0,  "w": 4, "h": 4, "key": "active-players" },
    "2":  { "x": 8,  "y": 0,  "w": 4, "h": 4, "key": "players-alive" },
    "3":  { "x": 12, "y": 0,  "w": 4, "h": 4, "key": "game-duration" },
    "4":  { "x": 16, "y": 0,  "w": 4, "h": 4, "key": "frame-consistency" },
    "5":  { "x": 20, "y": 0,  "w": 4, "h": 4, "key": "frame-jitter" },
    "6":  { "x": 0,  "y": 4,  "w": 12, "h": 7, "key": "game-loop-hz" },
    "7":  { "x": 12, "y": 4,  "w": 12, "h": 7, "key": "game-loop-jitter-graph" },
    "8":  { "x": 0,  "y": 11, "w": 8,  "h": 7, "key": "games-by-mode" },
    "9":  { "x": 8,  "y": 11, "w": 12, "h": 7, "key": "games-started" },
    "10": { "x": 20, "y": 11, "w": 4,  "h": 4, "key": "dropped-frames" }
  }
}
