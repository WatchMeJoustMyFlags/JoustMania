      "key": "game-loop-jitter"
    },
    "6": {
      "x": 12,
      "y": 5,
      "w": 12,
      "h": 7,
      "key": "game-loop-update-rate"
    },
    "7": {
      "x": 0,
      "y": 12,
      "w": 12,
      "h": 7,
      "key": "games-started-5m"
    },
    "8": {
      "x": 16,
      "y": 5,
      "w": 4,
      "h": 5,
      "key": "frame-consistency"
    },
    "9": {
      "x": 20,
      "y": 5,
      "w": 4,
