    "4": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Game Duration",
      "type": "data",
      "query": "timeseries dur = avg(game_duration_seconds) | fieldsAdd last = arrayLast(dur) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        }
      }
    },
    "5": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Frame Consistency",
      "type": "data",
      "query": "timeseries pct = avg(game_loop_frame_consistency_percent) | fieldsAdd last = arrayLast(pct) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "last",
              "value": 0,
              "customColor": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "last",
              "value": 90,
              "customColor": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "last",
              "value": 95,
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            }
          ]
        }
      }
    },
    "6": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Dropped Frames",
      "type": "data",
      "query": "timeseries dropped = sum(game_loop_frames_dropped_total, rate: 1m) | fieldsAdd last = arrayLast(dropped) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": {
            "isVisible": true
          }
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "last",
              "value": 0,
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "last",
              "value": 10,
              "customColor": {
                "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)"
              }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "last",
              "value": 50,
              "customColor": {
                "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)"
              }
            }
          ]
        }
      }
    },
    "7": {
      "content": "### Frame Timing\n\nGame loop rate and jitter over time. Red threshold = performance degradation.\n\n-----",
      "type": "markdown"
    },
    "8": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Game Loop Rate",
      "type": "data",
      "query": "timeseries hz = avg(game_actual_update_frequency_hz)",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "lineChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": [
              "hz"
            ],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "Hz"
          },
          "legend": {
            "hidden": true
          },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "9": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Game Loop Jitter Over Time",
      "type": "data",
      "query": "timeseries jitter = avg(game_loop_jitter_ms)",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "lineChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": [
              "jitter"
            ],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "Jitter (ms)"
          },
          "legend": {
            "hidden": true
          },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "10": {
      "content": "### Game Modes\n\nMode distribution and game start/death rates.\n\n-----",
      "type": "markdown"
    },
    "11": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "title": "Games by Mode",
      "type": "data",
      "query": "timeseries started = sum(games_started_total, rate: 1m), by:{mode}",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "pieChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "categoricalBarChartSettings": {
            "categoryAxis": [
              "mode"
            ],
            "categoryAxisLabel": "mode",
            "valueAxis": [
              "started"
            ],
            "valueAxisLabel": "started"
          },
          "circleChartSettings": {
            "groupingThresholdType": "relative",
            "valueType": "relative"
          },
          "legend": {
            "hidden": false
          },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "12": {
