            "label": "Memory (bytes)"
          },
          "legend": { "hidden": false },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "9": {
      "content": "### gRPC Traffic\n\nRequest rates and error rates across all services.\n\n-----",
      "type": "markdown"
    },
    "10": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "gRPC Request Rate by Service",
      "type": "data",
      "query": "timeseries requests = sum(grpc_requests_total, rate: 1m), by:{job}",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "barChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": ["requests"],
            "timestamp": "timeframe"
          },
          "categoricalBarChartSettings": {
            "groupMode": "stacked"
          },
          "legend": { "hidden": false },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "11": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "gRPC Errors by Service",
      "type": "data",
      "query": "timeseries errors = sum(grpc_requests_total, rate: 1m), by:{job, status} | filter status != \"OK\"",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "barChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": ["errors"],
            "timestamp": "timeframe"
          },
          "categoricalBarChartSettings": {
            "groupMode": "stacked"
          },
          "colorPalette": "fireplace",
          "legend": { "hidden": false },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "12": {
