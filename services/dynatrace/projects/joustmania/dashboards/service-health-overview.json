{
  "version": 14,
  "variables": [],
  "tiles": {
    "0": {
      "content": "### JoustMania — Service Health Overview\n\nAt-a-glance health for all platform services. Each hexagon is a service — hover for CPU, memory, threads, and error rate.\n\n-----",
      "type": "markdown"
    },
    "1": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "Service Health",
      "type": "data",
      "query": "timeseries cpu = avg(process_cpu_seconds_total, rate: 1m), mem = avg(process_resident_memory_bytes), threads = avg(process_threads), errors = sum(grpc_requests_total, rate: 1m), by:{job} | fieldsAdd cpuLast = arrayLast(cpu), memMB = arrayLast(mem) / 1048576, threadsLast = arrayLast(threads), errRate = arrayLast(errors) | fields job, cpuLast, memMB, threadsLast, errRate",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "honeycomb",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "honeycomb": {
          "colorMode": "custom-colors",
          "colorPalette": "blue",
          "dataMappings": {
            "value": "cpuLast"
          },
          "displayedFields": ["job", "cpuLast", "memMB", "threadsLast", "errRate"],
          "customColors": [
            {
              "comparator": "\u2265",
              "value": 0,
              "color": { "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)" }
            },
            {
              "comparator": "\u2265",
              "value": 0.5,
              "color": { "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)" }
            },
            {
              "comparator": "\u2265",
              "value": 0.8,
              "color": { "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)" }
            }
          ]
        },
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "cpuLast",
              "value": 0,
              "customColor": { "Default": "var(--dt-colors-charts-categorical-color-09-default, #649438)" }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "cpuLast",
              "value": 0.5,
              "customColor": { "Default": "var(--dt-colors-charts-status-warning-default, #f5d30f)" }
            },
            {
              "colorMode": "custom-color",
              "comparator": "\u2265",
              "field": "cpuLast",
              "value": 0.8,
              "customColor": { "Default": "var(--dt-colors-charts-apdex-unacceptable-default, #cd3741)" }
            }
          ]
        }
      }
    },
    "2": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "Game Active",
      "type": "data",
      "query": "timeseries active = avg(game_active) | fieldsAdd last = arrayLast(active) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": { "isVisible": true }
        }
      }
    },
    "3": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "Controllers Connected",
      "type": "data",
      "query": "timeseries controllers = avg(active_controllers_total) | fieldsAdd last = arrayLast(controllers) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": { "isVisible": true }
        }
      }
    },
    "4": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "Players Alive",
      "type": "data",
      "query": "timeseries alive = avg(game_players_alive) | fieldsAdd last = arrayLast(alive) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": { "isVisible": true }
        }
      }
    },
    "5": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "Games Started (24h)",
      "type": "data",
      "query": "timeseries games = sum(games_started_total, rate: 1m) | fieldsAdd last = arrayLast(games) | fields last",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "recordField": "last",
          "labelMode": "none",
          "trend": { "isVisible": true }
        }
      }
    },
    "6": {
      "content": "### Resource Usage\n\nCPU and memory trends per service over time.\n\n-----",
      "type": "markdown"
    },
    "7": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "CPU Usage by Service",
      "type": "data",
      "query": "timeseries cpu = avg(process_cpu_seconds_total, rate: 1m), by:{job}",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "areaChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": ["cpu"],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
            "isLabelVisible": true,
            "label": "CPU (cores)"
          },
          "legend": { "hidden": false },
          "truncationMode": "end"
        },
        "thresholds": []
      }
    },
    "8": {
      "davis": {
        "davisVisualization": { "isAvailable": true },
        "enabled": false
      },
      "title": "Memory Usage by Service",
      "type": "data",
      "query": "timeseries mem = avg(process_resident_memory_bytes), by:{job}",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "visualization": "areaChart",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "chartSettings": {
          "fieldMapping": {
            "leftAxisValues": ["mem"],
            "timestamp": "timeframe"
          },
          "leftYAxisSettings": {
