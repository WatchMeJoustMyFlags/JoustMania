{
  "enabled": true,
  "name": "joustmania:container",
  "displayName": "JoustMania Container",
  "createdBy": "monaco",
  "rules": [
    {
      "idPattern": "joustmania_container_{container.name}",
      "instanceNamePattern": "{container.name}",
      "iconPattern": "docker",
      "sources": [
        {
          "sourceType": "Metrics",
          "condition": "$prefix(container.cpu)"
        }
      ],
      "attributes": [
        {
          "key": "container_name",
          "displayName": "Container Name",
          "pattern": "{container.name}"
        },
        {
          "key": "container_image_name",
          "displayName": "Image",
          "pattern": "{container.image.name}"
        }
      ],
      "requiredDimensions": [
        {
          "key": "container.name"
        }
      ]
    }
  ]
}
