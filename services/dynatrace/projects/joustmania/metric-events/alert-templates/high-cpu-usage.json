{
  "summary": "High CPU usage on {{dims:job}} (> 80%)",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "process_cpu_percent",
    "aggregation": "AVG",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 80,
    "alertOnNoData": false,
    "alertCondition": "ABOVE",
    "violatingSamples": 5,
    "samples": 10,
    "dealertingSamples": 10
  },
  "eventTemplate": {
    "title": "High CPU Usage",
    "description": "Process CPU usage on {{dims:job}} exceeds 80%. Sustained high CPU may degrade game performance and controller responsiveness.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      }
    ]
  },
  "enabled": true
}
