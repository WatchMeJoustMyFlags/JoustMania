{
  "summary": "High GC pause duration on {{dims:job}} (P90 > 10ms)",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "gc_pause_seconds",
    "aggregation": "PERCENTILE90",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 0.010,
    "alertOnNoData": false,
    "alertCondition": "ABOVE",
    "violatingSamples": 7,
    "samples": 15,
    "dealertingSamples": 15
  },
  "eventTemplate": {
    "title": "High GC Pauses",
    "description": "Garbage collection pause duration P90 on {{dims:job}} exceeds 10ms. This may cause frame drops and gameplay stuttering. Consider memory optimization.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      },
      {
        "metadataKey": "prometheus_equivalent",
        "metadataValue": "histogram_quantile(0.95, rate(gc_pause_seconds_bucket[5m])) > 0.010"
      }
    ]
  },
  "enabled": true
}
