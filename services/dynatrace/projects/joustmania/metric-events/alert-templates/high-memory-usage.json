{
  "summary": "High memory usage on {{ "{{dims:job}}" }} (> 500 MB)",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "process_memory_mb",
    "aggregation": "AVG",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 500,
    "alertOnNoData": false,
    "alertCondition": "ABOVE",
    "violatingSamples": 5,
    "samples": 10,
    "dealertingSamples": 10
  },
  "eventTemplate": {
    "title": "High Memory Usage",
    "description": "Process memory usage on {{ "{{dims:job}}" }} exceeds 500 MB. This may indicate a memory leak or excessive resource consumption.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      }
    ]
  },
  "enabled": true
}
