{
  "summary": "High controller input latency detected (P90 > 50ms)",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "controller_input_lag_seconds",
    "aggregation": "PERCENTILE90",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 0.050,
    "alertOnNoData": false,
    "alertCondition": "ABOVE",
    "violatingSamples": 5,
    "samples": 10,
    "dealertingSamples": 10
  },
  "eventTemplate": {
    "title": "High Input Latency",
    "description": "Controller input latency P90 exceeds 50ms. This may affect gameplay responsiveness. Check Bluetooth interference and system load.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      },
      {
        "metadataKey": "prometheus_equivalent",
        "metadataValue": "histogram_quantile(0.95, rate(controller_input_lag_seconds_bucket[5m])) > 0.050"
      }
    ]
  },
  "enabled": true
}
