{
  "summary": "Controller {{dims:serial}} has low battery",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "controller_battery_level",
    "aggregation": "AVG",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 2,
    "alertOnNoData": false,
    "alertCondition": "BELOW",
    "violatingSamples": 3,
    "samples": 5,
    "dealertingSamples": 5
  },
  "eventTemplate": {
    "title": "Controller Low Battery",
    "description": "Controller {{dims:serial}} battery level is below 2/5. Replace or charge soon.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      }
    ]
  },
  "enabled": true
}
