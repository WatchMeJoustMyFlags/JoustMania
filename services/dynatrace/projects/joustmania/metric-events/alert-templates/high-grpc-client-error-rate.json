{
  "summary": "High gRPC client error rate on {{ "{{dims:job}}" }} (> 30 errors/min)",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "grpc_client_errors_total",
    "aggregation": "COUNT",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 30,
    "alertOnNoData": false,
    "alertCondition": "ABOVE",
    "violatingSamples": 5,
    "samples": 10,
    "dealertingSamples": 10
  },
  "eventTemplate": {
    "title": "High gRPC Client Error Rate",
    "description": "gRPC client error rate on {{ "{{dims:job}}" }} exceeds 30 errors per minute (equivalent to Prometheus rate > 0.5/s). Check downstream service availability and network connectivity.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      },
      {
        "metadataKey": "prometheus_equivalent",
        "metadataValue": "rate(grpc_client_errors_total[2m]) > 0.5"
      }
    ]
  },
  "enabled": true
}
