{
  "summary": "Games are being force-ended (possible crashes)",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "games_force_ended_total",
    "aggregation": "COUNT",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 1,
    "alertOnNoData": false,
    "alertCondition": "ABOVE",
    "violatingSamples": 5,
    "samples": 10,
    "dealertingSamples": 10
  },
  "eventTemplate": {
    "title": "Game Crash Rate",
    "description": "Games are being force-ended at an elevated rate. This is a simplified version of the Prometheus crash ratio alert (rate(games_force_ended_total) / rate(games_started_total) > 0.1). Investigate game coordinator logs for errors.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      },
      {
        "metadataKey": "prometheus_equivalent",
        "metadataValue": "rate(games_force_ended_total[10m]) / rate(games_started_total[10m]) > 0.1"
      }
    ]
  },
  "enabled": true
}
