{
  "summary": "Game loop frame consistency below 95%",
  "queryDefinition": {
    "type": "METRIC_KEY",
    "metricKey": "game_loop_frame_consistency_percent",
    "aggregation": "AVG",
    "entityFilter": {},
    "dimensionFilter": [],
    "managementZone": ""
  },
  "modelProperties": {
    "type": "STATIC_THRESHOLD",
    "threshold": 95,
    "alertOnNoData": false,
    "alertCondition": "BELOW",
    "violatingSamples": 5,
    "samples": 10,
    "dealertingSamples": 10
  },
  "eventTemplate": {
    "title": "Poor Frame Consistency",
    "description": "Game loop frame consistency has dropped below 95%. Players may experience jitter and uneven motion detection. Check CPU load and competing processes.",
    "eventType": "CUSTOM_ALERT",
    "davisMerge": true,
    "metadata": [
      {
        "metadataKey": "severity",
        "metadataValue": "warning"
      }
    ]
  },
  "enabled": true
}
