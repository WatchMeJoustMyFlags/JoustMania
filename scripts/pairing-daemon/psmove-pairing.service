[Unit]
Description=PS Move Controller Pairing Daemon
Documentation=https://github.com/adangert/JoustMania
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/opt/joustmania/bin/psmove-pairing-daemon
Restart=always
RestartSec=10

# Health check - verify daemon is responsive after startup
# Waits 5s for startup, then checks /healthz endpoint
ExecStartPost=/bin/sh -c 'sleep 5 && curl -sf http://localhost:8002/healthz || exit 1'

# Environment
Environment=POLL_INTERVAL=10
Environment=DEBUG=0
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Metrics and tracing
Environment=METRICS_PORT=8002
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# PyInstaller onefile extraction directory (avoids /tmp issues on locked-down systems)
RuntimeDirectory=psmove-pairing
Environment=TMPDIR=/run/psmove-pairing

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psmove-pairing

[Install]
WantedBy=multi-user.target
