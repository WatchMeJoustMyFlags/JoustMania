# The stage hotspot check (UC-061, FR-184; #2099). Installed by the hotspot
# setup; runs only the root-owned copy of scripts/setup/joustmania-hotspot.sh.
# Started at boot, by the dispatcher hook 90-joustmania-hotspot and by
# joustmania-hotspot.timer. It is independent of joustmania.service and never
# orders against it (BR-006).
[Unit]
Description=JoustMania stage hotspot fallback check (UC-061)
Wants=NetworkManager.service
After=NetworkManager.service
# No start limit: a burst of NM events must never block later checks (A6)
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/lib/joustmania/joustmania-hotspot evaluate
# evaluate waits at most 180 s plus a 30 s activation; a hung nmcli ends here
TimeoutStartSec=240
KillMode=mixed

[Install]
WantedBy=multi-user.target
