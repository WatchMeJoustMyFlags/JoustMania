[Unit]
Description=JoustMania Observability Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/JoustMania
ExecStartPre=+/bin/bash -c '\
  docker network inspect joustmania-network >/dev/null 2>&1 || docker network create joustmania-network; \
  docker ps -aq --filter "name=joustmania-obs-" | xargs -r docker rm -f 2>/dev/null; \
  docker container prune -f 2>/dev/null; \
  true'
ExecStart=/home/pi/JoustMania/scripts/setup/joustmania-observability-start.sh
ExecStop=/usr/bin/docker compose -f docker-compose.observability.yml down
TimeoutStartSec=300
User=pi
Group=pi

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
