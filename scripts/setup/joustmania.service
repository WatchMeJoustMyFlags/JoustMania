# Opt-in compose profiles (e.g. python-hid) go in a drop-in, not in .env:
# .env is tracked by git, so editing it breaks the start script's
# `git pull --ff-only`. `sudo systemctl edit joustmania` and add:
#   [Service]
#   Environment=COMPOSE_PROFILES=python-hid
# ExecStart and ExecStop both inherit it (#1402 S2).
#
# Compose calls go through scripts/setup/joustmania-compose.sh: -f
# docker-compose.yml (a bare `docker compose` also loads the dev override
# that publishes the mock control and gRPC ports, #1319) plus .env and the
# git-ignored .env.local when present (stage IMAGE_TAG + API keys, #1488).
[Unit]
Description=JoustMania Docker Compose Application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/JoustMania
ExecStartPre=+/bin/bash -c '\
  docker ps -aq --filter "name=joustmania-" | xargs -r docker rm -f 2>/dev/null; \
  docker container prune -f 2>/dev/null; \
  true'
ExecStart=/home/pi/JoustMania/scripts/setup/joustmania-start.sh
ExecStop=/home/pi/JoustMania/scripts/setup/joustmania-compose.sh down
TimeoutStartSec=600
User=pi
Group=pi

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
