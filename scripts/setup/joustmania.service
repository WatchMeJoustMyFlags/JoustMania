# Opt-in compose profiles (python-hid, operator-pad) go in .env.local or a
# drop-in, never in .env (tracked by git). Set the whole comma-separated list
# in one place: a unit drop-in Environment= wins over .env.local, so a drop-in
# naming only python-hid switches the operator pad off. For a drop-in,
# `sudo systemctl edit joustmania` and add:
#   [Service]
#   Environment=COMPOSE_PROFILES=python-hid,operator-pad
# ExecStart and ExecStop both inherit it (#1402 S2).
#
# Compose calls go through scripts/setup/joustmania-compose.sh: -f
# docker-compose.yml (a bare `docker compose` also loads the dev override
# that publishes the mock control and gRPC ports, #1319) plus .env and the
# git-ignored .env.local when present (stage IMAGE_TAG + API keys, #1488).
[Unit]
Description=JoustMania Docker Compose Application
Requires=docker.service
Wants=network-online.target bluetooth.service
After=docker.service network-online.target bluetooth.service
# 3 starts in 15 minutes, then systemd stops retrying (UC-060 A5). This bounds
# fast failures only: an attempt that runs into TimeoutStartSec (900 s) plus
# RestartSec ends outside the window. The start script bounds an attempt: it
# pulls nothing at boot and the game phase (`up` and readiness) is bounded at
# 180 s, so a failing attempt ends within about 4 minutes, before
# observability starts.
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/JoustMania
# The start script checks this: a newer script under an older installed unit
# logs "unit outdated" and never loops (UC-060, #2027)
Environment=JOUSTMANIA_UNIT_REV=2
# Start state (start.env) lives here; it survives a restart of the unit
RuntimeDirectory=joustmania
RuntimeDirectoryPreserve=yes
# No ExecStartPre that removes containers and no `down`: a reboot with
# unchanged images recreates nothing (UC-060 BR-001, NFR-026)
ExecStart=/home/pi/JoustMania/scripts/setup/joustmania-start.sh
ExecStop=/home/pi/JoustMania/scripts/setup/joustmania-compose.sh stop --timeout 20
TimeoutStartSec=900
TimeoutStopSec=120
User=pi
Group=pi

# Restart policy (bounded by StartLimit* above; nothing is torn down on retry)
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
