# Opt-in compose profiles (e.g. python-hid) go in a drop-in, not in .env:
# .env is tracked by git, so editing it breaks the start script's
# `git pull --ff-only`. `sudo systemctl edit joustmania` and add:
#   [Service]
#   Environment=COMPOSE_PROFILES=python-hid
# ExecStart and ExecStop both inherit it (#1402 S2).
#
# Compose calls name their files with -f: a bare `docker compose` also loads
# docker-compose.override.yml, the dev file that publishes the mock control
# and gRPC ports on all interfaces (#1319).
[Unit]
Description=JoustMania Docker Compose Application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/JoustMania
ExecStartPre=+/bin/bash -c '\
  docker ps -aq --filter "name=joustmania-" | xargs -r docker rm -f 2>/dev/null; \
  docker container prune -f 2>/dev/null; \
  true'
ExecStart=/home/pi/JoustMania/scripts/setup/joustmania-start.sh
ExecStop=/usr/bin/docker compose -f docker-compose.yml down
TimeoutStartSec=600
User=pi
Group=pi

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
